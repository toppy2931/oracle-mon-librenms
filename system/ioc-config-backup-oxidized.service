[Unit]
Description=IOC managed Oxidized configuration backup engine
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/oracle-mon/config-backup/oxidized/config

[Service]
Type=simple
User=oracle-backup
Group=oracle-backup
UMask=0077
Environment=HOME=/var/lib/oracle-mon/config-backup
Environment=OXIDIZED_HOME=/var/lib/oracle-mon/config-backup/oxidized
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env oxidized --home-dir /var/lib/oracle-mon/config-backup/oxidized
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/oracle-mon/config-backup

[Install]
WantedBy=multi-user.target
