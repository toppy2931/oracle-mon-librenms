[Unit]
Description=IOC device behavior collection and alert delivery
After=network-online.target

[Service]
Type=oneshot
User=librenms
Group=librenms
Environment=LIBRENMS_DIR=/opt/librenms
ExecStart=/usr/bin/php /opt/oracle-mon/admin/ioc-behavior-tick.php
TimeoutStartSec=90
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
