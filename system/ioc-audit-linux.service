[Unit]
Description=IOC agentless Linux host checks
After=network-online.target

[Service]
Type=oneshot
User=ioc-audit
Group=ioc-audit
ExecStart=/usr/bin/python3 -B /opt/oracle-mon/admin/ioc-audit-spool.py --kind linux
TimeoutStartSec=180
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/oracle-mon/ioc-audit-linux-results
