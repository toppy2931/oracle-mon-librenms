[Unit]
Description=IOC configuration backup schedule and result reconciliation
After=network-online.target ioc-config-backup-oxidized.service
ConditionPathExists=/var/lib/oracle-mon/config-backup/oxidized/config

[Service]
Type=oneshot
User=oracle-backup
Group=oracle-backup
UMask=0077
ExecStart=/usr/bin/python3 /opt/oracle-mon/admin/ioc-config-backup.py --tick
TimeoutStartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/oracle-mon/config-backup
StandardOutput=null
