[Unit]
Description=IOC read-only network configuration checks
After=network-online.target ioc-config-backup.service

[Service]
Type=oneshot
User=oracle-backup
Group=oracle-backup
ExecStart=/usr/bin/python3 -B /opt/oracle-mon/admin/ioc-audit-spool.py --kind network
TimeoutStartSec=210
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/oracle-mon/ioc-audit-network-results
